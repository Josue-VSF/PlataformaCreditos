@model IEnumerable<PlataformaCreditos.Models.SolicitudPendienteViewModel>

@{
    ViewData["Title"] = "Panel Analista";
}

<h1 class="mb-4">Panel del Analista</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        No hay solicitudes pendientes de revisión.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Cliente</th>
                    <th scope="col">Monto solicitado</th>
                    <th scope="col">Ingresos mensuales</th>
                    <th scope="col">Fecha</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var solicitud = item.Solicitud;
                    <tr>
                        <td>@solicitud.Id</td>
                        <td>
                            @solicitud.NombreCliente
                            <span class="text-muted d-block small">@solicitud.UserId</span>
                        </td>
                        <td>@solicitud.MontoSolicitado.ToString("C")</td>
                        <td>@item.IngresosMensuales.ToString("C")</td>
                        <td>@solicitud.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <form asp-action="Aprobar" asp-controller="Analista" asp-route-id="@solicitud.Id" method="post"
                                      onsubmit="return confirm('¿Seguro que deseas APROBAR la solicitud #@solicitud.Id?');">
                                    <button type="submit" class="btn btn-sm btn-success">Aprobar</button>
                                </form>
                                <button type="button" class="btn btn-sm btn-danger"
                                        data-bs-toggle="modal" data-bs-target="#modalRechazo-@solicitud.Id">
                                    Rechazar
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @foreach (var item in Model)
    {
        var solicitud = item.Solicitud;
        <div class="modal fade" id="modalRechazo-@solicitud.Id" tabindex="-1"
             aria-labelledby="modalRechazoLabel-@solicitud.Id" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-action="Rechazar" asp-controller="Analista" asp-route-id="@solicitud.Id" method="post">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalRechazoLabel-@solicitud.Id">Rechazar solicitud #@solicitud.Id</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>
                        <div class="modal-body">
                            <label for="motivoRechazo-@solicitud.Id" class="form-label">Motivo de rechazo</label>
                            <textarea id="motivoRechazo-@solicitud.Id" name="motivoRechazo"
                                      class="form-control" rows="3" maxlength="500" required></textarea>
                            <div class="form-text">Máximo 500 caracteres. Este texto será visible para el cliente.</div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-danger">Rechazar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}